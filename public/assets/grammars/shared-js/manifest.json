{
	"id": "shared-js",
	"scopeName": "source.js",
	"extensions": [".js", ".mjs", ".cjs", ".jsx"],
	"grammars": [{ "scopeName": "source.js", "file": "JavaScript.tmLanguage.json" }],
	"languageData": {
		"commentTokens": { "line": "//", "block": { "open": "/*", "close": "*/" } },
		"closeBrackets": { "brackets": ["{", "[", "(", "\"", "'", "`"] }
	}
}
