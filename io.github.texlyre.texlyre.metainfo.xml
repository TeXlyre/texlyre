<?xml version="1.0" encoding="UTF-8"?>
<component type="web-application">
  <id>io.github.texlyre.texlyre</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <name>TeXlyre</name>
  <summary>Local-first LaTeX and Typst collaborative editor</summary>
  <developer id="io.github.texlyre">
    <name>Fares Abawi</name>
  </developer>

  <description>
    <p>
      TeXlyre is a local-first real-time LaTeX and Typst collaboration platform with offline editing capabilities.
    </p>
    <ul>
      <li>Edit documents together with live cursors, comments, chat and tracked changes</li>
      <li>Compile LaTeX and Typst documents in the browser</li>
      <li>Keep projects in the browser and synchronize them between peers</li>
      <li>Edit diagrams with the embedded Draw.io and TikZ editors</li>
    </ul>
  </description>

  <launchable type="url">https://texlyre.github.io/texlyre/</launchable>
  <icon type="remote" width="192" height="192">https://texlyre.github.io/texlyre/assets/images/TeXlyre_notext_192.png</icon>

  <categories>
