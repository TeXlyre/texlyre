		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-i18next": "^17.0.11",
		"remark-frontmatter": "^5.0.0",
		"remark-math": "^6.0.0",
		"texlyre-busytex": "^1.4.0",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.3.2",
		"wasm-latex-tools": "^0.1.1",
		"y-codemirror.next": "=0.3.5",
		"y-indexeddb": "^9.0.12",
